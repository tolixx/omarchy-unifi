#!/usr/bin/env python3
"""Small UniFi Network client for the omarchy-unifi shell plugin.

Talks to a UniFi gateway with an API key and prints JSON the QML side reads.

  omarchy-unifi bar                 WAN rates + client count, Waybar-style JSON
  omarchy-unifi clients             active clients with rates and their VPN route
  omarchy-unifi routes              policy routes ("traffic routes") with their VPN
  omarchy-unifi panel               everything the panel shows, in one call
  omarchy-unifi vpn <route-id> on|off
  omarchy-unifi vpns                list VPN clients a route can use
  omarchy-unifi route-add <mac> <vpn-id> [name]   send one device through a VPN
  omarchy-unifi route-del <route-id>              delete a route

Config: ~/.config/omarchy-unifi/config.json
  {"host": "https://192.168.1.1", "site": "default",
   "aliases": {"aa:bb:cc:dd:ee:ff": "Desk PC"},   optional names by MAC
   "hide_names": false}                           true: clients without an alias show as "Device N"
Key:    ~/.config/omarchy-unifi/key           (one line, chmod 600)
"""
import json
import re
import os
import ssl
import sys
import urllib.error
import urllib.request

CONF_DIR = os.path.expanduser(os.environ.get("OMARCHY_UNIFI_CONFIG", "~/.config/omarchy-unifi"))


def load_config():
    conf = {"host": "https://192.168.1.1", "site": "default"}
    try:
        with open(os.path.join(CONF_DIR, "config.json")) as f:
            conf.update(json.load(f))
    except FileNotFoundError:
        pass
    key_file = os.path.expanduser(conf.get("key_file", os.path.join(CONF_DIR, "key")))
    with open(key_file) as f:
        conf["key"] = f.read().strip()
    return conf


# The gateway serves a self-signed certificate on the LAN.
CTX = ssl.create_default_context()
CTX.check_hostname = False
CTX.verify_mode = ssl.CERT_NONE


def api(conf, path, method="GET", body=None):
    req = urllib.request.Request(
        conf["host"].rstrip("/") + "/proxy/network" + path,
        method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={"X-API-KEY": conf["key"], "Accept": "application/json", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, context=CTX, timeout=8) as r:
            raw = r.read()
    except urllib.error.HTTPError as e:
        # UniFi explains a rejected write in the body; surface that instead of "HTTP Error 400".
        detail = e.read().decode(errors="replace")[:300]
        try:
            j = json.loads(detail)
            detail = j.get("message") or j.get("meta", {}).get("msg") or detail
        except ValueError:
            pass
        raise ValueError(f"{method} failed ({e.code}): {detail}") from None
    data = json.loads(raw) if raw.strip() else {}
    return data["data"] if isinstance(data, dict) and "data" in data else data


def human_rate(bytes_per_s):
    bits = bytes_per_s * 8
    for unit in ("bit/s", "kbit/s", "Mbit/s", "Gbit/s"):
        if bits < 1000:
            return f"{bits:.0f} {unit}" if unit == "bit/s" else f"{bits:.1f} {unit}"
        bits /= 1000
    return f"{bits:.1f} Tbit/s"


def vpns(conf):
    nets = api(conf, f"/api/s/{conf['site']}/rest/networkconf")
    return [{"id": n["_id"], "name": n["name"], "type": n.get("vpn_type", ""), "enabled": n.get("enabled", True)}
            for n in nets if n.get("purpose") == "vpn-client"]


def vpn_names(conf):
    return {v["id"]: v["name"] for v in vpns(conf)}


def routes(conf):
    names = vpn_names(conf)
    out = []
    for r in api(conf, f"/v2/api/site/{conf['site']}/trafficroutes"):
        out.append({
            "id": r["_id"],
            "name": r.get("description", ""),
            "enabled": r.get("enabled", False),
            "vpn": names.get(r.get("network_id"), r.get("network_id")),
            "macs": [d["client_mac"] for d in r.get("target_devices", []) if d.get("type") == "CLIENT"],
            "per_device": r.get("matching_target") == "INTERNET"
                          and all(d.get("type") == "CLIENT" for d in r.get("target_devices", [])),
            "kill_switch": r.get("kill_switch_enabled", False),
        })
    return out


def clients(conf, route_list=None):
    by_mac = {}
    for r in route_list if route_list is not None else routes(conf):
        for m in r["macs"]:
            by_mac.setdefault(m, r)
    out = []
    for c in api(conf, f"/v2/api/site/{conf['site']}/clients/active"):
        r = by_mac.get(c.get("mac"))
        out.append({
            "name": c.get("display_name") or c.get("name") or c.get("mac"),
            "mac": c.get("mac"),
            "ip": c.get("ip"),
            "wired": c.get("is_wired", False),
            "rx": c.get("rx_bytes-r", 0),
            "tx": c.get("tx_bytes-r", 0),
            "route": {"id": r["id"], "vpn": r["vpn"], "enabled": r["enabled"]} if r else None,
        })
    out.sort(key=lambda c: -(c["rx"] + c["tx"]))
    aliases = {k.lower(): v for k, v in conf.get("aliases", {}).items()}
    n = 0
    for c in out:
        alias = aliases.get((c["mac"] or "").lower())
        if alias:
            c["name"] = alias
        elif conf.get("hide_names"):
            n += 1
            c["name"] = f"Device {n}"
    return out


def bar(conf, route_list=None):
    health = {s["subsystem"]: s for s in api(conf, f"/api/s/{conf['site']}/stat/health")}
    wan = health.get("wan", {})
    users = sum(health.get(k, {}).get("num_user", 0) for k in ("lan", "wlan"))
    # The gateway reports WAN rates from its own side: rx is download, tx is upload.
    down, up = wan.get("rx_bytes-r", 0), wan.get("tx_bytes-r", 0)
    vpn_on = sum(1 for r in (route_list if route_list is not None else routes(conf)) if r["enabled"])
    return {
        "text": f"↓ {human_rate(down)} ↑ {human_rate(up)}",
        "tooltip": f"{wan.get('isp_name', 'WAN')} {wan.get('status', '?')}\n{users} clients, {vpn_on} on VPN",
        "class": "ok" if wan.get("status") == "ok" else "down",
        "down": down, "up": up, "clients": users, "vpn_routes_on": vpn_on,
        "isp": wan.get("isp_name", ""), "status": wan.get("status", "?"),
    }


def panel(conf):
    route_list = routes(conf)
    cl = clients(conf, route_list)
    for r in route_list:
        r["online"] = sum(1 for c in cl if c["route"] and c["route"]["id"] == r["id"])
    vpn_list = [v for v in vpns(conf) if v["enabled"]]
    return {"bar": bar(conf, route_list), "routes": route_list, "clients": cl, "client_count": len(cl), "vpns": vpn_list}


def set_vpn(conf, route_id, on):
    path = f"/v2/api/site/{conf['site']}/trafficroutes"
    route = next((r for r in api(conf, path) if r["_id"] == route_id), None)
    if route is None:
        raise ValueError(f"no route {route_id}")
    route["enabled"] = on
    api(conf, f"{path}/{route_id}", method="PUT", body=route)
    return {"id": route_id, "enabled": on}


def add_route(conf, mac, vpn_id, name=""):
    mac = mac.lower()
    if not re.fullmatch(r"([0-9a-f]{2}:){5}[0-9a-f]{2}", mac):
        raise ValueError(f"not a MAC address: {mac}")
    vpn = next((v for v in vpns(conf) if v["id"] == vpn_id), None)
    if vpn is None:
        raise ValueError(f"no VPN client {vpn_id}")
    taken = next((r for r in routes(conf) if mac in r["macs"]), None)
    if taken:
        raise ValueError(f"{mac} is already on route {taken['name'] or taken['id']} ({taken['vpn']})")
    if not name:
        known = next((c for c in clients(conf) if c["mac"] == mac), None)
        name = known["name"] if known else mac
    body = {
        "description": name,
        "enabled": True,
        "matching_target": "INTERNET",
        "network_id": vpn_id,
        "target_devices": [{"client_mac": mac, "type": "CLIENT"}],
        "domains": [], "ip_addresses": [], "ip_ranges": [], "regions": [],
        "kill_switch_enabled": False,
    }
    created = api(conf, f"/v2/api/site/{conf['site']}/trafficroutes", method="POST", body=body)
    if isinstance(created, list):
        created = created[0] if created else {}
    return {"id": created.get("_id"), "name": name, "vpn": vpn["name"], "enabled": True}


def delete_route(conf, route_id):
    if not any(r["id"] == route_id for r in routes(conf)):
        raise ValueError(f"no route {route_id}")
    api(conf, f"/v2/api/site/{conf['site']}/trafficroutes/{route_id}", method="DELETE")
    return {"id": route_id, "deleted": True}


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd = argv[1]
    try:
        conf = load_config()
        if cmd == "bar":
            out = bar(conf)
        elif cmd == "clients":
            out = clients(conf)
        elif cmd == "routes":
            out = routes(conf)
        elif cmd == "panel":
            out = panel(conf)
        elif cmd == "vpn" and len(argv) == 4 and argv[3] in ("on", "off"):
            out = set_vpn(conf, argv[2], argv[3] == "on")
        elif cmd == "vpns":
            out = vpns(conf)
        elif cmd == "route-add" and len(argv) in (4, 5):
            out = add_route(conf, argv[2], argv[3], argv[4] if len(argv) == 5 else "")
        elif cmd == "route-del" and len(argv) == 3:
            out = delete_route(conf, argv[2])
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except (OSError, ValueError, KeyError) as e:
        msg = f"no key file ({e.filename})" if isinstance(e, FileNotFoundError) else str(e)
        out = {"text": "UniFi ?", "tooltip": msg, "class": "error"} if cmd == "bar" else {"error": msg}
    print(json.dumps(out, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
