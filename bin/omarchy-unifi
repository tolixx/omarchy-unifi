#!/usr/bin/env python3
"""Small UniFi Network client for the omarchy-unifi shell plugin.

Talks to a UniFi gateway with an API key and prints JSON the QML side reads.

  omarchy-unifi bar                 WAN rates + client count, Waybar-style JSON
  omarchy-unifi clients             active clients with rates and their VPN route
  omarchy-unifi routes              policy routes ("traffic routes") with their VPN
  omarchy-unifi panel               everything the panel shows, in one call
  omarchy-unifi vpn <route-id> on|off
  omarchy-unifi vpns                list VPN clients a route can use
  omarchy-unifi route-add <mac> <vpn-id> [name]   send one device through a VPN
  omarchy-unifi route-del <route-id>              delete a route
  omarchy-unifi vpn-add <file.conf> [name]        upload a WireGuard config as a new VPN client
  omarchy-unifi vpn-files                         WireGuard configs found in conf_dirs
  omarchy-unifi pin                 trust the gateway's current certificate (run once)

Config: ~/.config/omarchy-unifi/config.json
  {"host": "https://192.168.1.1", "site": "default",
   "aliases": {"aa:bb:cc:dd:ee:ff": "Desk PC"},   optional names by MAC
   "hide_names": false,                           true: clients without an alias show as "Device N"
   "conf_dirs": ["~/Downloads", "~/.config/omarchy-unifi/wireguard"]}   where vpn-files looks
Key:    ~/.config/omarchy-unifi/key           (one line, chmod 600)
Pin:    ~/.config/omarchy-unifi/cert.sha256   (written by `pin`)

The key is only sent to a gateway whose certificate matches the pin, or that
passes normal TLS verification against "ca_file" when that is set in config.json.
"""
import hashlib
import http.client
import ipaddress
import json
import re
import os
import ssl
import sys
import urllib.parse

CONF_DIR = os.path.expanduser(os.environ.get("OMARCHY_UNIFI_CONFIG", "~/.config/omarchy-unifi"))


def load_config():
    conf = {"host": "https://192.168.1.1", "site": "default"}
    try:
        with open(os.path.join(CONF_DIR, "config.json")) as f:
            conf.update(json.load(f))
    except FileNotFoundError:
        pass
    key_file = os.path.expanduser(conf.get("key_file", os.path.join(CONF_DIR, "key")))
    with open(key_file) as f:
        conf["key"] = f.read().strip()
    return conf


PIN_FILE = os.path.join(CONF_DIR, "cert.sha256")


def read_pin():
    try:
        with open(PIN_FILE) as f:
            return f.read().strip().lower().replace(":", "") or None
    except FileNotFoundError:
        return None


def connect(conf, pinning=True):
    """Open a TLS connection to the gateway and authenticate it before anything is sent.

    UniFi gateways serve a self-signed certificate, so by default the certificate is
    pinned by its SHA-256 fingerprint (see `pin`). With "ca_file" in config.json the
    connection is verified the normal way instead, hostname included.
    """
    u = urllib.parse.urlsplit(conf["host"])
    if u.scheme != "https" or not u.hostname:
        raise ValueError(f"host must look like https://192.168.1.1, got {conf['host']!r}")
    if u.path not in ("", "/"):
        # UniFi OS serves the API at /proxy/network on the gateway itself; a path would be dropped.
        raise ValueError(f"host takes no path, use https://{u.netloc}")
    ca_file = conf.get("ca_file")
    if ca_file:
        ctx = ssl.create_default_context(cafile=os.path.expanduser(ca_file))
    else:
        # No CA to check against: the fingerprint check below authenticates the gateway.
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    c = http.client.HTTPSConnection(u.hostname, u.port or 443, context=ctx, timeout=8)
    c.connect()
    if ca_file or not pinning:
        return c
    fp = hashlib.sha256(c.sock.getpeercert(binary_form=True)).hexdigest()
    pin = read_pin()
    if pin is None:
        c.close()
        raise ValueError("gateway certificate not pinned yet, run: omarchy-unifi pin")
    if fp != pin:
        c.close()
        raise ValueError("gateway certificate does not match the pin, key not sent. "
                         "If you changed the certificate yourself, run: omarchy-unifi pin")
    return c


def pin(conf):
    """Trust on first use: save the fingerprint of the certificate the gateway serves now."""
    c = connect(conf, pinning=False)
    try:
        cert = c.sock.getpeercert(binary_form=True)
    finally:
        c.close()
    fp = hashlib.sha256(cert).hexdigest()
    old = read_pin()
    os.makedirs(CONF_DIR, exist_ok=True)
    fd = os.open(PIN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)  # the mode above only applies when the file is created
    with os.fdopen(fd, "w") as f:
        f.write(fp + "\n")
    return {"host": conf["host"], "sha256": ":".join(fp[i:i + 2] for i in range(0, len(fp), 2)),
            "changed": old is not None and old != fp, "file": PIN_FILE}


def api(conf, path, method="GET", body=None):
    c = connect(conf)
    try:
        c.request(
            method,
            "/proxy/network" + path,
            body=json.dumps(body).encode() if body is not None else None,
            headers={"X-API-KEY": conf["key"], "Accept": "application/json", "Content-Type": "application/json"},
        )
        r = c.getresponse()
        status, raw = r.status, r.read()
    finally:
        c.close()
    if status >= 400:
        # UniFi explains a rejected write in the body; surface that instead of "HTTP Error 400".
        detail = raw.decode(errors="replace")[:300]
        try:
            j = json.loads(detail)
            detail = j.get("message") or j.get("meta", {}).get("msg") or detail
        except ValueError:
            pass
        raise ValueError(f"{method} failed ({status}): {detail}")
    data = json.loads(raw) if raw.strip() else {}
    return data["data"] if isinstance(data, dict) and "data" in data else data


def human_rate(bytes_per_s):
    bits = bytes_per_s * 8
    for unit in ("bit/s", "kbit/s", "Mbit/s", "Gbit/s"):
        if bits < 1000:
            return f"{bits:.0f} {unit}" if unit == "bit/s" else f"{bits:.1f} {unit}"
        bits /= 1000
    return f"{bits:.1f} Tbit/s"


def tunnels(conf):
    """Live state of each VPN client by network id. WireGuard has no real session,
    so the gateway's CONNECTED only means the peer is configured; sending with
    nothing coming back is the better sign of a dead tunnel."""
    try:
        conns = api(conf, f"/v2/api/site/{conf['site']}/vpn/connections").get("connections", [])
    except (OSError, ValueError, AttributeError):
        return {}
    out = {}
    for c in conns:
        status = c.get("status", "UNKNOWN")
        rx, tx = c.get("rx_rate_bps", 0) or 0, c.get("tx_rate_bps", 0) or 0
        if status != "CONNECTED":
            state = "down"
        elif tx > 2000 and rx == 0:
            state = "no-reply"
        else:
            state = "up"
        out[c.get("network_id")] = {"status": status, "state": state, "rx": rx // 8, "tx": tx // 8,
                                    "notes": c.get("notes", [])}
    return out


def vpns(conf, with_state=False):
    nets = api(conf, f"/api/s/{conf['site']}/rest/networkconf")
    out = [{"id": n["_id"], "name": n["name"], "type": n.get("vpn_type", ""), "enabled": n.get("enabled", True)}
           for n in nets if n.get("purpose") == "vpn-client"]
    if with_state:
        live = tunnels(conf)
        for v in out:
            v["tunnel"] = live.get(v["id"], {"status": "UNKNOWN", "state": "unknown"})
    return out


def vpn_names(conf):
    return {v["id"]: v["name"] for v in vpns(conf)}


def routes(conf):
    names = vpn_names(conf)
    out = []
    for r in api(conf, f"/v2/api/site/{conf['site']}/trafficroutes"):
        out.append({
            "id": r["_id"],
            "name": r.get("description", ""),
            "enabled": r.get("enabled", False),
            "vpn": names.get(r.get("network_id"), r.get("network_id")),
            "vpn_id": r.get("network_id"),
            "macs": [d["client_mac"] for d in r.get("target_devices", []) if d.get("type") == "CLIENT"],
            "per_device": r.get("matching_target") == "INTERNET"
                          and all(d.get("type") == "CLIENT" for d in r.get("target_devices", [])),
            "kill_switch": r.get("kill_switch_enabled", False),
        })
    return out


def clients(conf, route_list=None):
    by_mac = {}
    for r in route_list if route_list is not None else routes(conf):
        for m in r["macs"]:
            by_mac.setdefault(m, r)
    out = []
    for c in api(conf, f"/v2/api/site/{conf['site']}/clients/active"):
        r = by_mac.get(c.get("mac"))
        out.append({
            "name": c.get("display_name") or c.get("name") or c.get("mac"),
            "mac": c.get("mac"),
            "ip": c.get("ip"),
            "wired": c.get("is_wired", False),
            "rx": c.get("rx_bytes-r", 0),
            "tx": c.get("tx_bytes-r", 0),
            "route": {"id": r["id"], "vpn": r["vpn"], "enabled": r["enabled"]} if r else None,
        })
    out.sort(key=lambda c: -(c["rx"] + c["tx"]))
    aliases = {k.lower(): v for k, v in conf.get("aliases", {}).items()}
    n = 0
    for c in out:
        alias = aliases.get((c["mac"] or "").lower())
        if alias:
            c["name"] = alias
        elif conf.get("hide_names"):
            n += 1
            c["name"] = f"Device {n}"
    return out


def bar(conf, route_list=None):
    health = {s["subsystem"]: s for s in api(conf, f"/api/s/{conf['site']}/stat/health")}
    wan = health.get("wan", {})
    users = sum(health.get(k, {}).get("num_user", 0) for k in ("lan", "wlan"))
    # The gateway reports WAN rates from its own side: rx is download, tx is upload.
    down, up = wan.get("rx_bytes-r", 0), wan.get("tx_bytes-r", 0)
    vpn_on = sum(1 for r in (route_list if route_list is not None else routes(conf)) if r["enabled"])
    return {
        "text": f"↓ {human_rate(down)} ↑ {human_rate(up)}",
        "tooltip": f"{wan.get('isp_name', 'WAN')} {wan.get('status', '?')}\n{users} clients, {vpn_on} on VPN",
        "class": "ok" if wan.get("status") == "ok" else "down",
        "down": down, "up": up, "clients": users, "vpn_routes_on": vpn_on,
        "isp": wan.get("isp_name", ""), "status": wan.get("status", "?"),
    }


def panel(conf):
    route_list = routes(conf)
    cl = clients(conf, route_list)
    for r in route_list:
        r["online"] = sum(1 for c in cl if c["route"] and c["route"]["id"] == r["id"])
    vpn_list = [v for v in vpns(conf, with_state=True) if v["enabled"]]
    state = {v["id"]: v["tunnel"]["state"] for v in vpn_list}
    for r in route_list:
        r["tunnel"] = state.get(r["vpn_id"], "unknown")
    return {"bar": bar(conf, route_list), "routes": route_list, "clients": cl, "client_count": len(cl), "vpns": vpn_list}


def set_vpn(conf, route_id, on):
    path = f"/v2/api/site/{conf['site']}/trafficroutes"
    route = next((r for r in api(conf, path) if r["_id"] == route_id), None)
    if route is None:
        raise ValueError(f"no route {route_id}")
    route["enabled"] = on
    api(conf, f"{path}/{route_id}", method="PUT", body=route)
    return {"id": route_id, "enabled": on}


def add_route(conf, mac, vpn_id, name=""):
    mac = mac.lower()
    if not re.fullmatch(r"([0-9a-f]{2}:){5}[0-9a-f]{2}", mac):
        raise ValueError(f"not a MAC address: {mac}")
    vpn = next((v for v in vpns(conf) if v["id"] == vpn_id), None)
    if vpn is None:
        raise ValueError(f"no VPN client {vpn_id}")
    taken = next((r for r in routes(conf) if mac in r["macs"]), None)
    if taken:
        raise ValueError(f"{mac} is already on route {taken['name'] or taken['id']} ({taken['vpn']})")
    if not name:
        known = next((c for c in clients(conf) if c["mac"] == mac), None)
        name = known["name"] if known else mac
    body = {
        "description": name,
        "enabled": True,
        "matching_target": "INTERNET",
        "network_id": vpn_id,
        "target_devices": [{"client_mac": mac, "type": "CLIENT"}],
        "domains": [], "ip_addresses": [], "ip_ranges": [], "regions": [],
        "kill_switch_enabled": False,
    }
    created = api(conf, f"/v2/api/site/{conf['site']}/trafficroutes", method="POST", body=body)
    if isinstance(created, list):
        created = created[0] if created else {}
    return {"id": created.get("_id"), "name": name, "vpn": vpn["name"], "enabled": True}


def delete_route(conf, route_id):
    if not any(r["id"] == route_id for r in routes(conf)):
        raise ValueError(f"no route {route_id}")
    api(conf, f"/v2/api/site/{conf['site']}/trafficroutes/{route_id}", method="DELETE")
    return {"id": route_id, "deleted": True}


def parse_wg_conf(text):
    """Check a wg-quick config enough to catch a wrong file before the gateway sees it.
    Returns the Interface addresses; key values are never returned or printed."""
    section, seen, addrs = None, {}, []
    for line in text.splitlines():
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        m = re.fullmatch(r"\[(\w+)\]", line)
        if m:
            section = m.group(1).lower()
            seen.setdefault(section, set())
            continue
        if "=" not in line or section is None:
            raise ValueError("not a WireGuard config: expected [Interface] and [Peer] sections")
        k, v = (s.strip() for s in line.split("=", 1))
        seen[section].add(k.lower())
        if section == "interface" and k.lower() == "address":
            addrs += [a.strip() for a in v.split(",") if a.strip()]
    need = {"interface": ("privatekey", "address"), "peer": ("publickey", "endpoint")}
    missing = [f"[{s.capitalize()}] {k}" for s, keys in need.items() for k in keys if k not in seen.get(s, ())]
    if missing:
        raise ValueError("WireGuard config is missing " + ", ".join(missing))
    return addrs


def read_wg_conf(path):
    path = os.path.expanduser(path)
    if not os.path.isfile(path):
        raise ValueError(f"no such file: {path}")
    if os.path.getsize(path) > 16384:
        raise ValueError(f"{os.path.basename(path)} is too big for a WireGuard config")
    with open(path, encoding="utf-8") as f:
        text = f.read()
    return text, parse_wg_conf(text)


def conf_dirs(conf):
    return [os.path.expanduser(d) for d in conf.get("conf_dirs", ["~/Downloads", os.path.join(CONF_DIR, "wireguard")])]


def vpn_files(conf):
    """WireGuard configs the panel can offer for upload: *.conf in conf_dirs that parse."""
    out = []
    for d in conf_dirs(conf):
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            p = os.path.join(d, n)
            if not n.endswith(".conf") or not os.path.isfile(p):
                continue
            try:
                _, addrs = read_wg_conf(p)
            except (OSError, ValueError, UnicodeDecodeError):
                continue
            out.append({"path": p, "file": n, "name": os.path.splitext(n)[0], "address": ", ".join(addrs)})
    return out


def add_vpn(conf, path, name=""):
    """Upload a wg-quick .conf as a new WireGuard VPN client, like the file upload in the UniFi UI.
    The gateway reads Address and MTU from the file itself."""
    text, addrs = read_wg_conf(path)
    name = (name or os.path.splitext(os.path.basename(path))[0]).strip()
    if not name:
        raise ValueError("empty name")
    nets = api(conf, f"/api/s/{conf['site']}/rest/networkconf")
    if any(n.get("name", "").lower() == name.lower() for n in nets):
        raise ValueError(f"a network called {name} already exists, pick another name")
    # The gateway refuses an overlapping subnet with a bare "SubnetOverlapped"; say which one.
    for a in addrs:
        try:
            mine = ipaddress.ip_interface(a).network
        except ValueError:
            raise ValueError(f"bad Address in the config: {a}")
        for n in nets:
            try:
                other = ipaddress.ip_interface(n.get("ip_subnet", "")).network
            except ValueError:
                continue
            if mine.version == other.version and mine.overlaps(other):
                raise ValueError(f"{a} overlaps {n['name']} ({other}), the gateway won't take it")
    body = {
        "name": name,
        "purpose": "vpn-client",
        "vpn_type": "wireguard-client",
        "enabled": True,
        "wireguard_client_mode": "file",
        "wireguard_client_configuration_file": text,
        "wireguard_client_configuration_filename": os.path.basename(path),
    }
    try:
        created = api(conf, f"/api/s/{conf['site']}/rest/networkconf", method="POST", body=body)
    except ValueError as e:
        if "SubnetOverlapped" in str(e):
            raise ValueError("the tunnel address overlaps a network on the gateway") from None
        raise
    if isinstance(created, list):
        created = created[0] if created else {}
    return {"id": created.get("_id"), "name": name, "added": True,
            "subnet": created.get("ip_subnet") or ", ".join(addrs)}


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd = argv[1]
    try:
        conf = load_config()
        if cmd == "bar":
            out = bar(conf)
        elif cmd == "clients":
            out = clients(conf)
        elif cmd == "routes":
            out = routes(conf)
        elif cmd == "panel":
            out = panel(conf)
        elif cmd == "vpn" and len(argv) == 4 and argv[3] in ("on", "off"):
            out = set_vpn(conf, argv[2], argv[3] == "on")
        elif cmd == "vpns":
            out = vpns(conf, with_state=True)
        elif cmd == "route-add" and len(argv) in (4, 5):
            out = add_route(conf, argv[2], argv[3], argv[4] if len(argv) == 5 else "")
        elif cmd == "route-del" and len(argv) == 3:
            out = delete_route(conf, argv[2])
        elif cmd == "vpn-add" and len(argv) in (3, 4):
            out = add_vpn(conf, argv[2], argv[3] if len(argv) == 4 else "")
        elif cmd == "vpn-files":
            out = vpn_files(conf)
        elif cmd == "pin":
            out = pin(conf)
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except (OSError, ValueError, KeyError, UnicodeDecodeError, http.client.HTTPException) as e:
        if isinstance(e, FileNotFoundError):
            msg = f"no key file ({e.filename})"
        elif isinstance(e, http.client.HTTPException):
            msg = f"odd reply from the gateway ({type(e).__name__}: {str(e).strip()})"
        else:
            msg = str(e)
        out = {"text": "UniFi ?", "tooltip": msg, "class": "error"} if cmd == "bar" else {"error": msg}
    print(json.dumps(out, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
